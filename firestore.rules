rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Профиль пользователя — вся личная синхронизируемая часть appState (задачи, запасы, очки
    // и т.д.) живёт в одном документе users/{uid}. Доступ только владельцу.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Список email-ов, которым платный доступ не нужен никогда (первые тестировщики,
    // добавленные ещё до запуска подписки — см. monetization plan). Читает любой залогиненный
    // клиент при проверке пейволла; редактируется только вручную через консоль Firebase — из
    // приложения этот документ никогда не пишется, поэтому allow write отсутствует (по
    // умолчанию запрещено).
    match /config/grandfatheredUsers {
      allow read: if request.auth != null;
    }

    // Семьи / Домохозяйства (общие списки покупок) — id документа сам по себе служит кодом
    // приглашения (см. household.create/showShareListSheetForHousehold в коде): это случайная
    // строка Firestore с огромной энтропией, так что allow get ниже безопасен — угадать чужой
    // id практически невозможно, прочитать документ может только тот, кому реально дали ссылку/код.
    match /households/{id} {
      allow get: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        // Присоединение по коду — разрешено менять только поле members, и только добавляя
        // себя, а не заменяя список целиком. hasAll(...) — это и есть весь фикс: без него
        // кто угодно с валидным кодом мог прислать members:[свой_uid] и вычеркнуть остальных
        // участников, даже пользуясь только официальным клиентом Firestore (не самим приложением
        // — оно всегда шлёт arrayUnion, но правила должны защищать и от прямых запросов к API).
        (request.auth.uid in request.resource.data.members &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
         request.resource.data.members.hasAll(resource.data.members))
      );
      allow create: if request.auth != null && request.resource.data.members == [request.auth.uid];


      // Вложенная коллекция предметов/запасов
      match /items/{itemId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(id)).data.members;
      }
    }

  }
}
