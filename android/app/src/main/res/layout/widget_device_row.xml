<?xml version="1.0" encoding="utf-8"?>
<!-- One row inside the "Контроль дома" widget's ListView (see HomeControlListService). The whole
     row is a single tap target — unlike the Дела/Покупки rows there's only one thing to do with a
     device from the widget (open the camera for it), so there's no need for the two-target
     checkbox-vs-pencil split those use. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="12dp"
    android:paddingRight="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_row_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />

        <!-- "Light" version of the app's photo gallery (2026-09-27) — just the latest photo, not
             the full scrollable set the in-app "Контроль дома" tab shows, and no per-photo delete
             here. Sending every stored photo (or full-resolution ones) to the widget would bloat
             its SharedPreferences file for a home-screen widget that's supposed to stay small and
             quick to refresh; one already-compressed thumbnail per device is the compromise
             Kristina picked over the fuller (but heavier) alternative. GONE (see
             HomeControlListService.getViewAt) when the device has no photo yet. -->
        <ImageView
            android:id="@+id/widget_row_thumb"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:scaleType="fitStart"
            android:adjustViewBounds="true" />
    </LinearLayout>

    <!-- The app's own hand-drawn camera icon (www/icons/icon_camera.png, copied in as
         widget_camera_icon.png — 2026-09-27, replaces the plain 📷 emoji) rather than a system
         font glyph, matching the illustrated style the rest of the app uses for its icons. Doubles
         as "add another photo" once one already exists — same tap target, openCameraForDevice
         doesn't distinguish first photo from a retake. -->
    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_camera_icon"
        android:contentDescription="@string/home_control_camera_desc" />
</LinearLayout>
