<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- false so Android's auto-backup can't restore CapacitorUpdater's persisted "current
         bundle" state across an uninstall — with it true, a fresh reinstall could silently come
         back with a stale OTA-downloaded web bundle active instead of the one just built. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Firebase Analytics (src/analytics.js): no Advertising ID — the app has no ads, and
             the privacy policy / Play Data safety form say analytics only. -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Join-list deep link, custom scheme (misterlapkins://join?code=XXXX). Kept
                 alongside the verified https App Link below for any already-shared links still
                 using it. See src/deeplink.js (@capacitor/app's appUrlOpen) for where this
                 actually gets picked up on the web side. singleTask above means an
                 already-running app gets this via onNewIntent, not a fresh launch —
                 BridgeActivity handles that itself.
                 host="open" (2026-09-16) is a second, unrelated use of the same custom-scheme
                 mechanism — the widget's "+" button (see MrLapkinsWidgetProvider) launches
                 misterlapkins://open?action=add-task|add-shopping to jump straight to the
                 relevant add flow instead of just opening the app to whatever screen it last
                 had open. Same src/deeplink.js listener handles both hosts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="misterlapkins" android:host="join" />
                <data android:scheme="misterlapkins" android:host="open" />
            </intent-filter>
            <!-- Verified https App Link (https://mister-lapkins.web.app/join?code=XXXX) — this is
                 what actually shows up as a tappable link in WhatsApp/Telegram/etc, unlike the
                 custom scheme above. autoVerify requires hosting/.well-known/assetlinks.json
                 (declares this app's release-keystore SHA-256 fingerprint) to be live at that
                 domain; Android checks it at install time. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="mister-lapkins.web.app" android:pathPrefix="/join" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen widget (Дела + Покупки) — see the widget plan doc / MrLapkinsWidgetProvider's
             own comment for the full design. exported="true" on the receiver is required for
             APPWIDGET_UPDATE to actually reach it (the launcher process delivers that broadcast). -->
        <receiver
            android:name=".MrLapkinsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mr_lapkins_widget_info" />
        </receiver>
        <service
            android:name=".WidgetListService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <!-- Picks which shopping list this widget instance shows — see WidgetConfigureActivity's
             own class comment for the two ways it's reached (initial placement vs re-picking
             later from the widget's own list-name button). exported="true" + the CONFIGURE
             intent-filter is required for the system's own widget-placement flow to find it.
             AppTheme.NoActionBar, NOT ...NoActionBarLaunch — that one's windowBackground is the
             Capacitor splash graphic (@drawable/splash, swapped out by the Bridge once
             MainActivity's WebView loads); this activity never does that swap, so with the Launch
             theme the splash logo showed through behind our own content everywhere our layout
             didn't opaquely paint over it (reported by Kristina as a "странное окно", 2026-09-17).
             taskAffinity="" is required too — without it this activity defaults to sharing a task
             with MainActivity (singleTask, same default affinity), so finishing it revealed the
             app's own main screen underneath instead of the home screen/widget (reported by
             Kristina 2026-09-17: "выбрасывает... на главный экран приложения"). excludeFromRecents
             keeps this one-shot picker out of the recent-apps list too, since it's not a screen
             worth switching back to. -->
        <activity
            android:name=".WidgetConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- "Контроль дома" — a second, separate home-screen widget (see
             HomeControlWidgetProvider's own comment for why it's not a third tab on the widget
             above; Kristina's explicit request, 2026-09-27). No configure activity — every
             instance just shows the one on-device appliance roster, nothing per-instance to pick. -->
        <receiver
            android:name=".HomeControlWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_control_widget_info" />
        </receiver>
        <service
            android:name=".HomeControlListService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Without this, Android 12+ can delay scheduled task-reminder/Pomodoro notifications by
         several minutes instead of firing at the exact requested time. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Needed to even ask whether the app is exempt from battery optimization and to show the
         OS's own exemption-request dialog (see BatteryOptimizationPlugin.java) — a normal
         permission, granted automatically at install, no runtime prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Runtime-requested by @capacitor/camera itself (src/camera.js) when Camera.getPhoto() is
         first called — this manifest entry is just what makes that runtime prompt possible at all.
         Replaces the old <input type="file" capture> approach (2026-09-27), which never needed an
         explicit CAMERA permission since the OS's own camera app handled that permission itself. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- firebase-analytics (src/analytics.js) merges these in on its own — stripped so the app
         truly has no advertising ID access, matching the "no" Play Console Advertising ID
         declaration and the privacy policy. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <!-- Declaring android.permission.CAMERA above makes the Android build tools IMPLICITLY add
         <uses-feature android:name="android.hardware.camera" required="true"> unless told
         otherwise — that implicit requirement is what made Play Console report ~433 devices
         (tablets, TVs, Android Auto, Chromebooks — anything without a camera) as newly
         unsupported for this release. The "Контроль дома" camera shortcut is an optional
         convenience, not something the app needs to function, so every camera-related feature
         is explicitly marked not required here to keep the app installable on cameraless
         devices exactly as before this permission was added (2026-09-27). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
